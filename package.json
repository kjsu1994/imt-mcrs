{
  "name": "mcsr-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-cesium.mjs",
    "dev": "npm run assets && vite --host 127.0.0.1",
    "build": "npm run assets && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "simulate": "tsx scripts/run-scenario.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "benchmark:mcsr": "tsx scripts/benchmark-mcsr.ts",
    "benchmark:compare": "tsx scripts/compare-benchmarks.ts",
    "benchmark:browser": "tsx scripts/benchmark-browser.ts",
    "analyze:compare": "tsx scripts/analyze-compare.ts"
  },
  "dependencies": {
    "cesium": "1.146.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
